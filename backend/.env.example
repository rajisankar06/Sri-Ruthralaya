# Server Configuration
PORT=5000
NODE_ENV=production

# Database (Neon PostgreSQL connection string)
DATABASE_URL=

# JWT Authentication Secrets (Must be defined in production)
JWT_SECRET=
JWT_REFRESH_SECRET=

# AI Chatbot & Insights API Keys (Google Gemini [Recommended], OpenAI, or Claude - optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloud Media Storage (Cloudinary - optional)
CLOUDINARY_URL=

# Allowed CORS Origins (Comma-separated for multiple)
FRONTEND_URL=
